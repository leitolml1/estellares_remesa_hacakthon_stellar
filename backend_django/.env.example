# Django
DJANGO_SECRET_KEY=change-me-in-real-envs
# Default real (si no se define) es false - en local hay que ponerlo en
# true a mano, como aca.
DJANGO_DEBUG=true
# En Render no hace falta agregar el dominio ".onrender.com" aca: se suma
# solo via la variable RENDER_EXTERNAL_HOSTNAME que Render ya inyecta
# (ver config/settings.py). Esto es para hosts EXTRA (dominio propio, etc).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Red Stellar (defaults apuntan a testnet si no se definen)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Blend Protocol (Modulo 3 - inversion automatica de la caja familiar).
# Pool ya desplegado por el equipo de Blend en testnet, no es un contrato
# propio del proyecto.
BLEND_POOL_CONTRACT_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF

# Postgres (Neon, u otro Postgres; metadata de pagos/pools, el ledger de
# Stellar sigue siendo la fuente de verdad de montos/estados). Si es Neon,
# copiar la connection string tal cual la da su dashboard (con sslmode y
# channel_binding incluidos).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# CORS (abierto en dev para que el frontend pegue desde cualquier puerto)
CORS_ALLOW_ALL_ORIGINS=true

# Vault comunitario (Modulo 2) - contrato Soroban propio (vault_contract/)
VAULT_CONTRACT_ID=CATQKYDF53TJDHK5WHXAXUAKV4GMPDLIJY5BB3PCUHE5RO467JDVILJK
