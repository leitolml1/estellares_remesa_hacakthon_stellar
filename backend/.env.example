# Red Stellar (defaults apuntan a testnet si no se definen)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Postgres (metadata de pools/pagos, el ledger de Stellar sigue siendo la
# fuente de verdad de montos/estados)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=remesa_directa
# true solo para dev/hackathon (sin migraciones todavia); en produccion real
# poner en false y manejar el schema con migrations.
DB_SYNCHRONIZE=true
