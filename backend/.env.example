# Red Stellar (defaults apuntan a testnet si no se definen)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# RPC de Soroban (necesario solo para la integracion con Blend en
# family-pools). Renombrado de "Soroban-RPC" a "Stellar RPC" en nov 2024,
# misma URL. Confirmado en https://developers.stellar.org/docs/data/apis/rpc
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Referencia (NO son env vars: blendPoolId/investedAssetCode/Issuer se
# configuran por FamilyPool, ver POST /family-pools). Valores de testnet
# confirmados contra blend-capital/blend-utils/testnet.contracts.json:
#   Pool Blend v2 en testnet: CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
#   USDC (asset clasico) en testnet: CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
#     (este es el contract id Soroban/SAC del USDC clasico, se deriva con
#     Asset(code, issuer).contractId(networkPassphrase), no hace falta
#     guardarlo aparte)

# Postgres (metadata de pools/pagos, el ledger de Stellar sigue siendo la
# fuente de verdad de montos/estados)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=remesa_directa
# true solo para dev/hackathon (sin migraciones todavia); en produccion real
# poner en false y manejar el schema con migrations.
DB_SYNCHRONIZE=true
